# ---- state ----
REDIS_URL=redis://localhost:6379/0
SESSION_HMAC_KEY=change-me-32-bytes-minimum

# ---- policy ----
HOST=example.com
ALLOWED_DOMAINS=admin.example.com,example.com,api.example.com,partner.example.com
ALLOWED_COUNTRY_CODES=966,971,965,968
EXCLUDED_NUMBERS=
PREFIX_TABLE_PATH=config/prefixes.json
SOURCE_LIMITS_PATH=config/source_limits.json
ATTESTATION_GRACE_UNTIL=2026-11-01T00:00:00Z
GLOBAL_SMS_PER_HOUR=10000
GLOBAL_SPEND_UNITS_PER_HOUR=10000
RESPONSE_FLOOR_MS=400
SMS_KILL_SWITCH=false
INTERNAL_SERVICE_CREDENTIALS=
SMS_PROVIDER=PROVIDER_A
TRUSTED_PROXIES=10.0.0.0/8
REQUIRE_REAL_PROVIDERS=true

# ---- vendors ----
RECAPTCHA_SECRET=
RECAPTCHA_ACTION=otp_request
RECAPTCHA_HOSTNAMES=example.com,app.example.com
GOOGLE_APPLICATION_CREDENTIALS=/secrets/google-sa.json
PLAY_INTEGRITY_PACKAGE=com.example.app
APP_ATTEST_APP_ID=TEAMID1234.com.example.app
IPINFO_TOKEN=
ABUSEIPDB_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
